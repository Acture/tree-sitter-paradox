{
  "name": "tree-sitter-paradox",
  "version": "0.2.0",
  "description": "Paradox grammar for tree-sitter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acture/foch.git",
    "directory": "packages/tree-sitter-paradox"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "acture",
    "email": "acturea@gmail.com"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "paradox"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.25.8"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
